@@ -220,12 +222,31 @@
 	return 0;
 }
 
+static void pm8941_pwrkey_arm_wake(struct timer_list *t)
+{
+	struct pm8941_pwrkey *pwrkey = from_timer(pwrkey, t, wake_timer);
+
+	enable_irq_wake(pwrkey->irq);
+	pwrkey->wake_armed = true;
+}
+
 static int pm8941_pwrkey_suspend(struct device *dev)
 {
 	struct pm8941_pwrkey *pwrkey = dev_get_drvdata(dev);
 
-	if (device_may_wakeup(dev))
-		enable_irq_wake(pwrkey->irq);
+	if (device_may_wakeup(dev)) {
+		/*
+		 * nabu: the PMIC reports a ~150ms "press" a few milliseconds
+		 * after suspend entry although nobody touched the tablet, which
+		 * ends s2idle immediately (measured on 6.14 and 6.18 alike).
+		 * Arm the wakeup from a timer instead, so the transient is
+		 * delivered and handled while the IRQ is not a wakeup source,
+		 * and only presses after that wake the system.
+		 */
+		pwrkey->wake_armed = false;
+		mod_timer(&pwrkey->wake_timer,
+			  jiffies + msecs_to_jiffies(1000));
+	}
 
 	return 0;
 }
