@@ -331,6 +339,23 @@
 
 static DEFINE_SIMPLE_DEV_PM_OPS(pm8941_pwr_key_pm_ops,
 				pm8941_pwrkey_suspend, pm8941_pwrkey_resume);
+
+/*
+ * nabu: black-box marker for the s2idle investigation.  The PM8150 SDAM
+ * (sdam@b100) is RAM in the PMIC's always-on domain, so a byte written there
+ * survives an AP reset and can be read back after a hung boot through
+ * /sys/bus/nvmem/devices/spmi_sdam1/nvmem.
+ */
+#define NABU_SDAM_MARK_REG	0xb17e
+
+static struct pm8941_pwrkey *nabu_pwrkey;
+
+void nabu_suspend_mark(u8 v)
+{
+	if (nabu_pwrkey)
+		regmap_write(nabu_pwrkey->regmap, NABU_SDAM_MARK_REG, v);
+}
+EXPORT_SYMBOL_GPL(nabu_suspend_mark);
 
