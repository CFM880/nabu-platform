 {
@@ -505,6 +530,8 @@
 	platform_set_drvdata(pdev, pwrkey);
 	device_init_wakeup(&pdev->dev, wakeup);
 
+	nabu_pwrkey = pwrkey;
+
 	return 0;
 }
 
