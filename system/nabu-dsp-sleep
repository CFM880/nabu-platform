#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# Power down the remote processors that have no work while the AP sleeps.
#
# The SLPI (sensors), CDSP (compute) and ADSP (audio) keep running across
# system suspend on their own power domains; nothing tells them the AP is
# asleep, so they sit there burning current for the whole sleep, and the SLPI's
# FastRPC server crashes ("sensor_process ... frpc_dsp") when it wakes up with a
# session that timed out - which also aborts the suspend.
#
# Stopping them before sleep and starting them again on resume takes them off
# the rails entirely.  The modem is deliberately skipped: its runtime "stop"
# hard-hangs this SoC (see nabu-start-modem.sh), and the WCN3990 WLAN firmware
# is loaded through it.
set -u

state() { cat "$1/state" 2>/dev/null; }

find_rprocs() {
	for r in /sys/class/remoteproc/remoteproc*; do
		[ -e "$r/name" ] || continue
		[ "$(cat "$r/name" 2>/dev/null)" = "$1" ] && { echo "$r"; return 0; }
	done
	return 1
}

case "${1:-}" in
stop)
	for name in cdsp adsp slpi; do
		r=$(find_rprocs "$name") || continue
		[ "$(state "$r")" = running ] || continue
		echo stop >"$r/state" 2>/dev/null &&
			echo "nabu-dsp-sleep: stopped $name"
	done
	;;
start)
	for name in slpi adsp cdsp; do
		r=$(find_rprocs "$name") || continue
		[ "$(state "$r")" = offline ] || continue
		echo start >"$r/state" 2>/dev/null &&
			echo "nabu-dsp-sleep: started $name"
	done
	;;
*)
	echo "usage: $0 {stop|start}" >&2
	exit 2
	;;
esac
